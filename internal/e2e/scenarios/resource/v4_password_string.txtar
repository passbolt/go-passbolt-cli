# v4 password-string stores its secret as a plain string, not JSON.

pb create resource --type password-string --name test-v4-pwstring --username pws-user --uri https://pws.example.com --password plain-string-secret --json
cp stdout create.json
jsonget create.json id ID
defer pb delete resource --id $ID

pb get resource --id $ID --json
cp stdout get.json
jsoneq get.json name test-v4-pwstring
jsoneq get.json username pws-user
jsoneq get.json password plain-string-secret

# The string secret must survive a metadata-only update untouched.
pb update resource --id $ID --field name=test-v4-pwstring-renamed
pb get resource --id $ID --json
cp stdout renamed.json
jsoneq renamed.json name test-v4-pwstring-renamed
jsoneq renamed.json password plain-string-secret
