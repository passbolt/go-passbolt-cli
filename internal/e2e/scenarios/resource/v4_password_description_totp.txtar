# The v4 "password-description-totp" type carries password, description and totp together in the
# secret. It is the widest v4 secret shape, so it exercises the most of the routing that moves
# description between metadata and secret (helper.routeFieldBySchema).

pb create resource --type password-description-totp --name test-v4-pdt --username pdt-user --password pdt-pass --field description=pdt-desc --secret-field totp={"secret_key":"HXDMVJECJJWSRB3HWIZR4IFUGFTMXBOZ","algorithm":"SHA256","digits":8,"period":60} --json
cp stdout create.json
jsonget create.json id ID
defer pb delete resource --id $ID

pb get resource --id $ID --json
cp stdout get.json
jsoneq get.json name test-v4-pdt
jsoneq get.json username pdt-user
jsoneq get.json password pdt-pass
jsoneq get.json description pdt-desc
stdout HXDMVJECJJWSRB3HWIZR4IFUGFTMXBOZ
